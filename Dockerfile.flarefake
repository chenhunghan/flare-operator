# syntax=docker/dockerfile:1
# flarefake: the Cloudflare API emulator (cmd/flarefake) for e2e tests, with the pinned OpenAPI
# spec baked in at /spec/openapi.json.gz for request validation. Multi-arch like ./Dockerfile.
# Keep in step with the toolchain directive in go.mod (govulncheck: stdlib fixes).
ARG GO_VERSION=1.26.8

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS build
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w -X flare.dev/operator/internal/version.Version=${VERSION} -X flare.dev/operator/internal/version.Commit=${COMMIT} -X flare.dev/operator/internal/version.Date=${BUILD_DATE}" \
    -o /out/flarefake ./cmd/flarefake

FROM gcr.io/distroless/static-debian12:nonroot
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
# The repository has no permanent home yet (README "Status"); set SOURCE_URL when it does.
ARG SOURCE_URL=
# OCI image annotations (https://github.com/opencontainers/image-spec/blob/main/annotations.md).
# No licenses label: the repository carries no LICENSE file yet.
LABEL org.opencontainers.image.title="flarefake" \
      org.opencontainers.image.description="Cloudflare API emulator for flare-operator e2e tests" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.base.name="gcr.io/distroless/static-debian12:nonroot"
COPY --from=build /out/flarefake /flarefake
# spec/LOCK records the spec's source and sha256; ship it for traceability.
COPY spec/openapi.json.gz spec/LOCK /spec/
USER 65532:65532
EXPOSE 8787
ENTRYPOINT ["/flarefake"]
# The default listen address is 127.0.0.1, which is unreachable from outside the container.
CMD ["-addr=:8787", "-spec=/spec/openapi.json.gz"]
